# Casa TimTavio API — environment variables.
# Copy to `.env` for local dev (never commit `.env`). On Render these are set
# in the dashboard; DATABASE_URL / REDIS_HOST / REDIS_PORT are wired for you by
# the Blueprint (render.yaml).

# ── Core ──
NODE_ENV=development
PORT=4000

# ── Database (Prisma / PostgreSQL) ──
DATABASE_URL=postgresql://user:password@localhost:5432/casa_timtavio

# ── Redis (BullMQ queue) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Frontend origins (CORS allow-list) — one per deployed frontend ──
PWA_URL=http://localhost:3000
OWNER_DASHBOARD_URL=http://localhost:3001
EM_DASHBOARD_URL=http://localhost:3002

# ── Auth / signing ──
JWT_SECRET=replace-with-a-long-random-string
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.casatimtavio.com
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Lodgify (booking source of truth) ──
LODGIFY_API_KEY=
LODGIFY_PROPERTY_ID=
LODGIFY_WEBHOOK_SECRET=
# Optional. The rates calendar refuses to answer without a room type, and one is
# discovered from the property automatically — set this only to pin a specific
# room type if the villa ever has more than one.
LODGIFY_ROOM_TYPE_ID=

# ── Breezeway (staff tasks) ──
# OAuth2 credentials — the service exchanges these for a Bearer token automatically.
BREEZEWAY_CLIENT_ID=
BREEZEWAY_CLIENT_SECRET=
BREEZEWAY_ORG_ID=
BREEZEWAY_PROPERTY_ID=
BREEZEWAY_WEBHOOK_SECRET=
# Person ids from GET /public/inventory/v1/people (this account has no teams).
# Culinary/Wellness fall back to Concierge when left blank.
BREEZEWAY_CONCIERGE_PERSON_ID=
BREEZEWAY_CULINARY_PERSON_ID=
BREEZEWAY_WELLNESS_PERSON_ID=

# ── Broker availability page ──
# Shared secret between this API and the teaser site's server, which proxies
# the broker calendar's requests. Never reaches a browser — the same value must
# be set in the teaser repo. Any long random string.
BROKER_API_SECRET=

# ── Pusher (real-time channels) ──
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2

# ── Email (Resend) ──
RESEND_API_KEY=re_...
EMAIL_FROM=concierge@casatimtavio.com
RODRIGO_EMAIL=manager@casatimtavio.com
TO_EMAILS=manager@casatimtavio.com

# ── Web Push (VAPID) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:concierge@casatimtavio.com
VAPID_SUBJECT=mailto:concierge@casatimtavio.com

# ── Sortly (optional inventory sync) ──
SORTLY_API_TOKEN=
SORTLY_API_URL=https://api.sortly.co/api/v1
