generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  SETTLED
  DEPARTURE_TODAY
  CHECKED_OUT
  CANCELLED
}

enum ManifestStatus {
  INCOMPLETE
  IN_PROGRESS
  SUBMITTED
  APPROVED
}

enum GuestRole {
  PRIMARY
  SECONDARY
}

enum RoomType {
  KING_MASTER_SUITE
  LUXURY_BUNK_ROOM
}

enum RequestStatus {
  PENDING
  CONFLICT
  CONFIRMED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum FolioItemType {
  ESTATE_BASE_RATE
  EXPERIENCE
  INCIDENTAL
  PRE_STOCKED
  // Exclusive additions — the cellar and reserve list. Its own category rather
  // than an incidental: a $2,000 bottle reads oddly filed beside the minibar.
  DINING
}

// What a price unit multiplies its rate by when estimating a cost. Adding a new
// unit (e.g. "per night") is a PriceUnit row, not a migration — but a unit whose
// multiplier isn't one of these quantities needs a new source here first.
enum PriceMultiplierSource {
  NONE // flat — per group, per event
  GUEST_COUNT // × ExperienceRequest.guestCount
  NIGHTS // × Booking.nights
}

enum CatalogCategory {
  INCLUDED
  ARRIVAL_TRANSIT
  WELLNESS
  CULINARY_AGAVE
  OCEAN_ADVENTURE
  EXCURSIONS
  PRIVATE
}

enum MenuCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
  BEVERAGES
  // The only chargeable category. Everything else on the dining page is
  // all-inclusive, which is exactly why these are kept visibly apart.
  EXCLUSIVE
}

/**
 * Where a dish sits on the estate's printed menu.
 *
 * A course belongs to exactly one meal, which is what lets a limit be attached
 * to it without ambiguity: three breakfast mains and one daily suggestion are
 * two different allowances, not one allowance of four. Snacks, beverages and
 * exclusives are ordered on demand and have no course.
 */
enum MenuCourse {
  BREAKFAST_MAIN
  BREAKFAST_SUGGESTION
  LUNCH_SELECTION
  DINNER_STARTER
  DINNER_MAIN
  DINNER_DESSERT
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum NotificationType {
  EXPERIENCE_READY
  REQUEST_CONFIRMED
  CHARGE_ADDED
  REQUEST_CANCELLED
  MANIFEST_APPROVED
  MAGIC_LINK_SENT
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum AuditAction {
  BOOKING_CREATED
  BOOKING_UPDATED
  BOOKING_STATUS_CHANGED
  BOOKING_CHECKED_OUT
  MANIFEST_GUEST_ADDED
  MANIFEST_GUEST_UPDATED
  MANIFEST_GUEST_REMOVED
  MANIFEST_SUBMITTED
  MANIFEST_APPROVED
  MAGIC_LINK_SENT
  MAGIC_LINK_RESENT
  SESSION_REVOKED
  CATALOG_ITEM_CREATED
  CATALOG_ITEM_UPDATED
  CATALOG_ITEM_DELETED
  EXPERIENCE_REQUESTED
  EXPERIENCE_CONFIRMED
  EXPERIENCE_CANCELLED
  EXPERIENCE_READY
  EXPERIENCE_COMPLETED
  FOLIO_CHARGE_ADDED
  FOLIO_CHARGE_EDITED
  CHECKOUT_TRIGGERED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  VENDOR_CREATED
  VENDOR_UPDATED
}

// ─────────────────────────────────────────────────────────────────────────────
// BOOKING
// ─────────────────────────────────────────────────────────────────────────────

enum GuestArrivalStatus {
  EXPECTED
  IN_VILLA
  DEPARTED
}

model Booking {
  id                    String             @id @default(cuid())
  lodgifyId             String             @unique
  lodgifyRawData        Json?
  checkIn               DateTime
  checkOut              DateTime
  nights                Int
  totalGuests           Int                @default(1)
  // Primary member's own per-stay manifest details. The primary is NOT a
  // ManifestGuest row — manifestGuests stays secondary-only so magic-link/
  // approval flows are unchanged. Room + presence are per-stay and live here;
  // dietary/allergies/beverage stay on the primary's Guest record (shared with
  // chef's brief, guest DNA and CRM).
  primaryRoomNumber     Int?
  primaryArrivalStatus  GuestArrivalStatus @default(EXPECTED)
  status                BookingStatus      @default(CONFIRMED)
  manifestStatus        ManifestStatus     @default(INCOMPLETE)
  baseRate              Decimal            @db.Decimal(10, 2)
  taxRate               Decimal            @default(0.08) @db.Decimal(5, 4)
  serviceChargeRate     Decimal            @default(0.15) @db.Decimal(5, 4)
  stripeCustomerId      String?
  stripePaymentIntentId String?
  stripeDepositAmount   Decimal?           @db.Decimal(10, 2)
  stripeDepositCaptured Boolean            @default(false)
  stripeCheckoutAmount  Decimal?           @db.Decimal(10, 2)
  stripeCapturedAt      DateTime?
  internalNotes         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Relations — explicit names to avoid Prisma ambiguity
  primaryGuestId     String
  primaryGuest       Guest               @relation("BookingPrimaryGuest", fields: [primaryGuestId], references: [id])
  manifestGuests     ManifestGuest[]
  manifestDraft      ManifestDraft?
  folioItems         FolioItem[]
  experienceRequests ExperienceRequest[]
  diningRequests     DiningRequest[]
  menuSelections     MenuSelection[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([status])
  @@index([checkIn])
  @@index([checkOut])
  @@index([lodgifyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// GUEST
// ─────────────────────────────────────────────────────────────────────────────

model Guest {
  id                   String    @id @default(cuid())
  email                String    @unique
  firstName            String
  lastName             String
  phone                String?
  auth0Id              String?   @unique
  role                 GuestRole @default(SECONDARY)
  beveragePreferences  String?
  winePreferences      String?
  dietaryRestrictions  String[]  @default([])
  allergies            String?
  favouriteExperiences String[]  @default([])
  preferredTimes       String?
  dateOfBirth          DateTime?
  specialOccasions     String?
  preferredRoomType    RoomType?
  pillarPreferences    String?
  totalVisits          Int       @default(0)
  totalSpend           Decimal   @default(0) @db.Decimal(12, 2)
  firstStayDate        DateTime?
  lastStayDate         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Use the same explicit relation name here
  primaryBookings Booking[] @relation("BookingPrimaryGuest")
  crmNotes        CrmNote[]

  @@index([email])
  @@index([auth0Id])
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM NOTE
// ─────────────────────────────────────────────────────────────────────────────

model CrmNote {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id])
  note      String
  addedBy   String
  isStale   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([guestId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MANIFEST GUEST
// ─────────────────────────────────────────────────────────────────────────────

model ManifestGuest {
  id                  String             @id @default(cuid())
  bookingId           String
  booking             Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName           String
  lastName            String
  email               String
  phone               String?
  dateOfBirth         DateTime?
  relationship        String?
  roomNumber          Int?
  room                Room?              @relation(fields: [roomNumber], references: [number])
  // Per-guest presence (REQ-5) — tracked independently so a late arrival isn't
  // shown as present just because the primary checked the booking in.
  arrivalStatus       GuestArrivalStatus @default(EXPECTED)
  dietaryRestrictions String[]           @default([])
  dietaryOtherDetails String?
  allergies           String?
  beveragePreferences String?
  specialNotes        String?
  auth0UserId         String?
  pwaLinkSent         Boolean            @default(false)
  pwaLinkSentAt       DateTime?
  pwaLinkOpened       Boolean            @default(false)
  pwaLinkOpenedAt     DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([bookingId, email])
  @@index([bookingId])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// ROOM
// ─────────────────────────────────────────────────────────────────────────────

model Room {
  number      Int      @id
  name        String
  type        RoomType
  capacity    Int
  bedConfig   String
  beds        Json     @default("[]") // [{ type: 'king'|'queen'|'double'|'twin'|'single'|'bunk'|'sofa', count: number }]
  bathrooms   Int      @default(1)
  ensuite     Boolean  @default(false)
  amenities   String[] @default([]) // 'balcony'|'ac'|'pool_view'|'ocean_view'|'walk_in_closet'|'workspace'|'smart_tv'|'minibar'
  description String?
  imageUrl    String?
  floorLevel  Int?
  isActive    Boolean  @default(true)

  manifestGuests ManifestGuest[]
}

// ─────────────────────────────────────────────────────────────────────────────
// EXPERIENCE CATEGORY (EM-managed filter groups)
// ─────────────────────────────────────────────────────────────────────────────

model ExperienceCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  catalogItems CatalogItem[]

  @@index([isActive])
  @@index([sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// PRICE UNIT
// ─────────────────────────────────────────────────────────────────────────────

// A lookup rather than an enum so the estate can add units (e.g. "per night")
// without a migration. `multiplierSource` is what makes the estimate compute;
// a unit needing a quantity we don't capture yet (e.g. per hour) also needs a
// new input on the request form before it will work end to end.
model PriceUnit {
  id               String                @id @default(cuid())
  code             String                @unique // PER_PERSON
  label            String // "Per person" — EM-facing
  shortLabel       String // "/ person" — guest-facing, appended to the rate
  multiplierSource PriceMultiplierSource @default(NONE)
  isActive         Boolean               @default(true)
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  catalogItems CatalogItem[]

  @@index([isActive])
  @@index([sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// CATALOG ITEM
// ─────────────────────────────────────────────────────────────────────────────

model CatalogItem {
  id                   String              @id @default(cuid())
  name                 String
  category             CatalogCategory
  experienceCategoryId String?
  experienceCategory   ExperienceCategory? @relation(fields: [experienceCategoryId], references: [id])
  description          String              @db.Text
  shortDescription     String?
  isIncluded           Boolean             @default(false)
  isActive             Boolean             @default(true)
  durationMinutes      Int?
  durationLabel        String?
  photoUrls            String[]            @default([])
  primaryPhotoUrl      String?
  // Pricing is always an ESTIMATE — it varies with group size and season, and
  // Rodrigo issues the hard quote before the service is booked. `basePrice` is
  // the single estimate, or the low end when `priceMax` is set (a range).
  basePrice            Decimal?            @db.Decimal(10, 2)
  priceMax             Decimal?            @db.Decimal(10, 2)
  priceUnitId          String?
  priceUnit            PriceUnit?          @relation(fields: [priceUnitId], references: [id])
  isMultiDay           Boolean             @default(false)
  multiDayDuration     Int?
  availableTimeSlots   String[]            @default([])
  maxGuestCount        Int?
  // What's-included bullet list shown on the guest experience detail
  included             String[]            @default([])
  // Host shown on the guest experience detail
  hostName             String?
  hostTitle            String?
  hostAvatarUrl        String?
  hostReviewNote       String?
  setupLeadTimeMinutes Int?
  vendorId             String?
  vendor               Vendor?             @relation(fields: [vendorId], references: [id])
  breezeWayTeamId      String?
  breezeWayTemplateId  String?
  /**
   * Whether the estate's own staff have anything to prepare.
   *
   * A therapist who arrives with her own table needs nothing from the villa,
   * and a Breezeway task nobody actions is a task everybody learns to ignore.
   * Off means the request never reaches READY — nothing was prepared, so
   * there's nothing to report ready.
   */
  needsSetupTask       Boolean             @default(true)
  sortOrder            Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdBy            String?
  // Soft-delete marker. Distinct from isActive (which is the guest-visibility
  // toggle): a deleted item is excluded from every catalog list, while an
  // inactive one still shows in the EM catalog but is hidden from guests.
  deletedAt            DateTime?

  experienceRequests ExperienceRequest[]

  @@index([category])
  @@index([experienceCategoryId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([isIncluded])
}

// ─────────────────────────────────────────────────────────────────────────────
// MENU ITEM
// ─────────────────────────────────────────────────────────────────────────────

model MenuItem {
  id                String       @id @default(cuid())
  name              String
  category          MenuCategory
  /**
   * Which part of the meal this belongs to, and therefore which allowance it
   * counts against when the party composes a day. Null for snacks, beverages
   * and exclusives, which are ordered on demand rather than composed.
   */
  course            MenuCourse?
  description       String?      @db.Text
  photoUrl          String?
  isActive          Boolean      @default(true)
  isVegetarian      Boolean      @default(false)
  isVegan           Boolean      @default(false)
  isGlutenFree      Boolean      @default(false)
  containsNuts      Boolean      @default(false)
  containsDairy     Boolean      @default(false)
  containsShellfish Boolean      @default(false)
  otherDietaryNotes String?
  /**
   * Set only on EXCLUSIVE items — everything else is included in the stay.
   * Read server-side when an order is placed; a client-supplied price is never
   * trusted.
   */
  price             Decimal?     @db.Decimal(10, 2)
  sortOrder         Int          @default(0)
  /**
   * Whether this belongs to the curated library.
   * Standing dishes are what the estate publishes on the Menu page — and for
   * snacks and beverages, what a guest can order at any hour. A one-off is
   * created while planning a single service: a real dish with the same photo
   * and dietary flags, but it never clutters the library. Promoting one is a
   * single flag, so a favourite can earn its place later.
   */
  isStanding        Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdBy         String?

  dailyMenuItems DailyMenuItem[]
  selectionItems MenuSelectionItem[]
}

// ─────────────────────────────────────────────────────────────────────────────
// MENU SELECTION — what one party has chosen to eat, for one meal on one day.
//
// The estate publishes the whole menu once; the primary member composes each
// day from it within the allowances the estate set. It replaces the weekly
// planner, where the estate decided the dishes and the guest only read them.
//
// A day closes ahead of service because the kitchen orders and preps against
// it. After the cutoff the estate can still amend — a party that changes its
// mind talks to the concierge, which is the same conversation they'd have had
// anyway, only now the estate can see what was already promised to the chef.
// ─────────────────────────────────────────────────────────────────────────────

model MenuSelection {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /** Date only — a meal belongs to a day, not an instant. */
  date     DateTime     @db.Date
  mealType MenuCategory

  /**
   * The party's own line to the kitchen: "we're out on the boat until one".
   * Carried verbatim onto the run sheet — it routinely changes how a meal is
   * cooked, and a paraphrase would lose that.
   */
  note String? @db.Text

  chosenByEmail String?
  chosenByName  String?
  chosenAt      DateTime?

  /**
   * Set when the estate edited a locked day on the party's behalf, so the run
   * sheet can say who changed it after the kitchen had already been told.
   */
  amendedByEmail String?
  amendedAt      DateTime?
  /**
   * The dish names as they stood before the estate's last amendment.
   *
   * A swap that silently replaces what the kitchen was told is worse than no
   * swap at all — the chef needs to see that tonight's main *was* the ribeye,
   * so this keeps the previous line-up rather than only the current one.
   */
  amendedFrom    Json?

  items MenuSelectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, date, mealType])
  @@index([date])
  @@index([bookingId])
}

model MenuSelectionItem {
  id          String        @id @default(cuid())
  selectionId String
  selection   MenuSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  /**
   * Snapshotted from the dish so the run sheet still groups correctly if the
   * estate later moves a dish to another course.
   */
  course      MenuCourse
  sortOrder   Int           @default(0)

  @@unique([selectionId, menuItemId])
  @@index([selectionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DAILY MENU — what the chef is actually cooking, on a given day, for a given
// meal. MenuItem alone has no notion of "today": every active dish was shown to
// every guest on every day, including ones the kitchen stopped making months
// ago. Snacks and beverages are genuinely always-available and stay out of this.
// ─────────────────────────────────────────────────────────────────────────────

model DailyMenu {
  id       String       @id @default(cuid())
  /**
   * Date only — a service belongs to a day, not an instant.
   */
  date     DateTime     @db.Date
  mealType MenuCategory
  /**
   * Optional line to guests, e.g. "Chef's table — the whole menu off the coast".
   */
  note     String?

  /**
   * Null until the estate publishes. A half-decided Thursday must never reach a
   * guest, so drafts are invisible outside the dashboard.
   */
  publishedAt DateTime?
  publishedBy String?

  items DailyMenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  @@unique([date, mealType])
  @@index([date])
}

model DailyMenuItem {
  id          String    @id @default(cuid())
  dailyMenuId String
  dailyMenu   DailyMenu @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)

  @@unique([dailyMenuId, menuItemId])
  @@index([dailyMenuId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DINING REQUEST — sit-down meal reservations + on-demand snack/drink orders.
// Dining is all-inclusive (no payment); guests pick a sitting time or order
// snacks/beverages, and the estate manager confirms.
// ─────────────────────────────────────────────────────────────────────────────

enum DiningRequestKind {
  SITTING
  ORDER
}

enum DiningRequestStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
}

model DiningRequest {
  id               String              @id @default(cuid())
  bookingId        String
  booking          Booking             @relation(fields: [bookingId], references: [id])
  requestedByEmail String
  requestedByName  String
  kind             DiningRequestKind
  status           DiningRequestStatus @default(REQUESTED)

  // SITTING (BREAKFAST / LUNCH / DINNER)
  mealType        MenuCategory?
  date            DateTime?
  time            String?
  partySize       Int?
  allergies       String?
  specialRequests String?

  // ORDER (SNACKS / BEVERAGES) — items: [{ menuItemId, name, quantity }]
  items        Json?
  requestedFor String?
  notes        String?

  // SITTING late-comers — secondary guests flag a late arrival to the primary's
  // sitting: [{ email, name, note?, allergies?, at }]
  lateArrivals Json?

  // ── Exclusive additions ────────────────────────────────────────────────────
  // The only chargeable part of dining, so the only part that needs a price, an
  // approval and a folio line.

  /**
   * Total of the exclusive items, priced server-side when the order is made.
   */
  totalAmount Decimal? @db.Decimal(10, 2)

  /**
   * The sitting an exclusive should arrive at, when the guest attached it.
   */
  linkedSittingId String?

  /**
   * False only while a secondary's chargeable order waits on the primary, who
   * carries the whole folio. Included dining never needs approval.
   */
  primaryApproved Boolean   @default(true)
  approvedBy      String?
  approvedAt      DateTime?
  declineReason   String?

  /**
   * Set when confirmed and charged, so cancelling can take the charge off.
   */
  folioItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// RECOMMENDATION
// ─────────────────────────────────────────────────────────────────────────────

model Recommendation {
  id          String   @id @default(cuid())
  name        String
  category    String
  location    String?
  description String?  @db.Text
  photoUrl    String?
  externalUrl String?
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
}

// ─────────────────────────────────────────────────────────────────────────────
// VENDOR
// ─────────────────────────────────────────────────────────────────────────────

model Vendor {
  id            String          @id @default(cuid())
  name          String
  category      CatalogCategory
  role          String
  bio           String?         @db.Text
  photoUrl      String?
  email         String?
  phone         String?
  status        VendorStatus    @default(ACTIVE)
  notes         String?
  totalBookings Int             @default(0)
  averageRating Decimal?        @db.Decimal(3, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  catalogItems  CatalogItem[]
  vendorRatings VendorRating[]
}

// ─────────────────────────────────────────────────────────────────────────────
// VENDOR RATING
// ─────────────────────────────────────────────────────────────────────────────

model VendorRating {
  id                  String            @id @default(cuid())
  vendorId            String
  vendor              Vendor            @relation(fields: [vendorId], references: [id])
  experienceRequestId String            @unique
  experienceRequest   ExperienceRequest @relation(fields: [experienceRequestId], references: [id])
  rating              Int
  notes               String?
  createdAt           DateTime          @default(now())

  @@index([vendorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXPERIENCE REQUEST
// ─────────────────────────────────────────────────────────────────────────────

model ExperienceRequest {
  id                     String        @id @default(cuid())
  bookingId              String
  booking                Booking       @relation(fields: [bookingId], references: [id])
  catalogItemId          String
  catalogItem            CatalogItem   @relation(fields: [catalogItemId], references: [id])
  requestedByEmail       String
  requestedByName        String
  guestTier              GuestRole
  preferredDate          DateTime
  preferredTime          String
  guestCount             Int
  specialRequests        String?       @db.Text
  returnDate             DateTime?
  transportPreference    String?
  status                 RequestStatus @default(PENDING)
  statusUpdatedAt        DateTime      @default(now())
  confirmedDate          DateTime?
  confirmedTime          String?
  confirmedCost          Decimal?      @db.Decimal(10, 2)
  emNotes                String?
  declineReason          String?
  conflictReason         String?
  breezeWayTaskId        String?       @unique
  breezeWayTaskCreatedAt DateTime?
  setupPhotoUrl          String?
  setupCompletedAt       DateTime?
  staffMemberName        String?
  folioItemId            String?       @unique
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  folioItem               FolioItem?    @relation("RequestFolioItem", fields: [folioItemId], references: [id])
  vendorRating            VendorRating?
  primaryApproved         Boolean       @default(false)
  primaryApprovedAt       DateTime?
  primaryApprovedBy       String? // email of primary member who approved
  requiresPrimaryApproval Boolean       @default(false)

  // Estimate shown to the guest at request time, snapshotted so later catalog
  // edits never rewrite what the primary actually approved. estimatedMax is
  // only set when the catalog item carries a range.
  estimatedMin  Decimal? @db.Decimal(10, 2)
  estimatedMax  Decimal? @db.Decimal(10, 2)
  priceUnitCode String?

  // Rodrigo's hard quote when it lands materially above the approved estimate:
  // parked here awaiting a second primary approval instead of going straight to
  // confirmedCost, so nobody is billed a number they never agreed to.
  quotedCost            Decimal?  @db.Decimal(10, 2)
  quoteApprovalRequired Boolean   @default(false)
  quoteApprovedAt       DateTime?
  quoteApprovedBy       String?

  // ── Booking the vendor ─────────────────────────────────────────────────
  //
  // Every vendor is booked by WhatsApp, by hand. That works; what didn't was
  // that the system had no idea whether it had happened — so a guest could be
  // told "confirmed" for an experience nobody had been asked about.
  //
  // Timestamps rather than new RequestStatus values: a request waiting on a
  // vendor is still pending, it's pending on something specific, and the enum
  // feeds every queue, filter and chip across three apps.

  /** The WhatsApp message was opened. The queue reads "with the vendor". */
  vendorAskedAt      DateTime?
  vendorAskedBy      String?
  /** An answer was recorded, whichever way it went. */
  vendorRepliedAt    DateTime?
  /** They said yes. Nothing reaches the guest as confirmed without this. */
  vendorConfirmedAt  DateTime?
  vendorDeclinedAt   DateTime?
  /**
   * Their number, kept apart from confirmedCost — one is what the vendor
   * charges the estate, the other what the estate charges the guest.
   */
  vendorQuotedCost   Decimal?  @db.Decimal(10, 2)
  /** "Ana is away, her brother Luis will take it." Verbatim. */
  vendorNote         String?   @db.Text
  /** A time they could do instead, for the guest to accept or turn down. */
  vendorProposedDate DateTime?
  vendorProposedTime String?

  // A guest asking to cancel something the estate has already confirmed. Not a
  // cancellation in itself — a vendor is booked by that point, so Rodrigo has
  // to unwind it and may incur a fee. Requests not yet confirmed skip this
  // entirely and are simply withdrawn.
  cancellationRequestedAt DateTime?
  cancellationRequestedBy String?
  cancellationReason      String?
  /**
   * Charged when a vendor bills the estate for cancelling late.
   */
  cancellationFee         Decimal?  @db.Decimal(10, 2)

  /**
   * Unwinding it with the vendor — the mirror of asking them in the first
   * place. Without it the guest could be told "cancelled" while the boat still
   * expected them, and the fee on their folio had no provenance: no record of
   * who was told, when, or whether the number came from the vendor or from a
   * guess.
   */
  vendorToldOfCancellationAt DateTime?
  vendorCancellationRepliedAt DateTime?
  vendorCancellationNote      String?   @db.Text

  @@index([bookingId])
  @@index([status])
  @@index([catalogItemId])
  @@index([breezeWayTaskId])
}

