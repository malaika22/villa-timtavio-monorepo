// SETTINGS — staff accounts, pricing rules & notification preferences
// ─────────────────────────────────────────────────────────────────────────────

enum StaffRole {
  ESTATE_MANAGER
  READ_ONLY
}

model StaffAccount {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  role      StaffRole @default(ESTATE_MANAGER)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model EstateSettings {
  id                 String   @id @default("singleton")
  villaBaseRate      Decimal  @default(0) @db.Decimal(10, 2)
  taxRate            Decimal  @default(0.16) @db.Decimal(5, 4)
  serviceChargeRate  Decimal  @default(0.16) @db.Decimal(5, 4)
  notifyNewInquiry   Boolean  @default(true)
  notifyNewRequest   Boolean  @default(true)
  notifyTaskOverdue  Boolean  @default(true)
  notifyInventoryLow Boolean  @default(true)
  notifyLodgifyError Boolean  @default(true)
  notifyStripeError  Boolean  @default(true)
  // Superseded by sittingWindows. Kept so the migration can read the old slots
  // when deriving a window, and so nothing is silently thrown away.
  sittingTimes       Json?
  /**
   * When each meal is served, as a window rather than a list of slots:
   * { "BREAKFAST": { "start": "09:00", "end": "11:00", "lastSeating": "10:30" } }
   *
   * `lastSeating` is the point of the whole shape. A guest who picked 11:00 off
   * a 9–11 list arrived exactly as the kitchen closed, so the estate needs to
   * say how long before the end it can still take a table.
   */
  sittingWindows     Json?
  /**
   * How many dishes a party may choose per course, and how far ahead a day
   * closes: { "cutoffHours": 24, "courseLimits": { "DINNER_MAIN": 1, ... } }
   */
  menuRules          Json?
  /**
   * Indicative nightly rates by season, used only where Lodgify has no rate
   * for a night:
   * [{ "name": "Green", "from": "2026-05-01", "to": "2026-10-31",
   *    "nightly": 4800, "minNights": 4 }]
   *
   * Exists because the estate wanted the broker page live before rates were
   * loaded into Lodgify. A number the estate chose and can defend is safer
   * than an invented placeholder, since a broker will quote whatever is on
   * screen to a real client. Lodgify wins the moment it has a rate.
   */
  seasonRates        Json?
  updatedAt          DateTime @default(now()) @updatedAt
}

