  CORPORATE_RETREAT
  FAMILY
  WEDDING
  CONTENT_PRODUCTION
  OTHER
}

model Inquiry {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String?
  preferredFrom DateTime?
  preferredTo   DateTime?
  guestCount    Int?
  purposeOfStay PurposeOfStay?
  socialHandle  String?
  source        String?
  message       String?        @db.Text
  status        InquiryStatus  @default(NEW)
  notes         String? // Rodrigo's internal notes on approval

  // Vetting tracking
  reviewedBy String? // Auth0 ID of EM who reviewed
  reviewedAt DateTime?

  // Decline
  declineReason String? // Internal only — never shown to visitor

  // Post-approval tracking
  lookbookSentAt    DateTime? // When Rodrigo manually sent the Lookbook
  lookbookSentBy    String?
  paymentLinkSentAt DateTime? // When Rodrigo sent the Stripe link
  paymentLinkSentBy String?
  stripePaymentLink String? // The actual Stripe payment link URL (logged for reference)

  // Conversion
  convertedToBookingId String? // Set when Lodgify webhook fires

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
}

