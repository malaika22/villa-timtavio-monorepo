{
  "comment": "Villa TimTavio widget theme. Apply via Management API: PATCH /api/v2/branding/themes/{themeId} (or POST to create). The page template (universal-login.liquid) styles the page chrome; THIS styles the injected login widget so the two match. Values mirror packages/theme/src/global.css.",
  "borders": {
    "button_border_radius": 8,
    "button_border_weight": 1,
    "buttons_style": "rounded",
    "input_border_radius": 8,
    "input_border_weight": 1,
    "inputs_style": "rounded",
    "widget_corner_radius": 12,
    "widget_border_weight": 1,
    "show_widget_shadow": true
  },
  "colors": {
    "primary_button": "#0f1f2e",
    "primary_button_label": "#ffffff",
    "secondary_button_border": "#e3e0da",
    "secondary_button_label": "#0f1f2e",
    "base_focus_color": "#c4a882",
    "base_hover_color": "#1a3040",
    "links_focused_components": "#5e3a31",
    "header": "#0f1f2e",
    "body_text": "#5e4737",
    "widget_background": "#ffffff",
    "widget_border": "#e3e0da",
    "input_labels_placeholders": "#797168",
    "input_filled_text": "#0f1f2e",
    "input_border": "#e3e0da",
    "input_background": "#ffffff",
    "icons": "#8c7261",
    "error": "#b3261e",
    "success": "#2e7d32"
  },
  "fonts": {
    "font_url": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap",
    "reference_text_size": 16,
    "title": { "bold": true, "size": 150 },
    "subtitle": { "bold": false, "size": 87.5 },
    "body_text": { "bold": false, "size": 87.5 },
    "buttons_text": { "bold": true, "size": 100 },
    "input_labels": { "bold": false, "size": 100 },
    "links": { "bold": true, "size": 87.5 },
    "links_style": "normal"
  },
  "page_background": {
    "background_color": "#f5f3f0",
    "page_layout": "left"
  },
  "widget": {
    "header_text_alignment": "left",
    "logo_position": "left",
    "logo_height": 44,
    "social_buttons_layout": "bottom"
  }
}
