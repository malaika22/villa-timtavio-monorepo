# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files. A wildcard rather than a list: `.env.production` and
# `.env.staging` were not covered by the enumerated names, and one `git add -A`
# is all it takes.
.env*
!.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist

# Incremental typecheck caches. Two of these were committed, so every `tsc`
# anyone ran left the tree dirty with a machine-specific file — noise in
# `git status` that trains you to ignore it, right up until it hides something.
*.tsbuildinfo


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
